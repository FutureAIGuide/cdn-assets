# CDN Assets Repository - .gitignore

# OS Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
*~

# IDE and Editor Files
.vscode/
.idea/
*.swp
*.swo
*.swn
.project
.settings/
*.sublime-project
*.sublime-workspace

# Build and temporary files
*.log
*.tmp
*.temp
/tmp/
/temp/

# Node modules (if using build tools)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Source files that should not be in CDN
*.psd
*.ai
*.sketch
*.fig
*.xd

# Backup files
*.bak
*.backup

# Test files (add if needed)
# /test/
# /tests/
